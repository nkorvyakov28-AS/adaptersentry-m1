        "kind": {
          "enum": [
            "code",
            "pickle",
            "archive",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "title": "SiblingFile",
      "type": "object"
    },
    "TokenConcentration": {
      "description": "How concentrated an update of lm_head / embed_tokens is on a few tokens.",
      "properties": {
        "module": {
          "title": "Module",
          "type": "string"
        },
        "top_token_ids": {
          "items": {
            "type": "integer"
          },
          "title": "Top Token Ids",
          "type": "array"
        },
        "top_shares": {
          "items": {
            "type": "number"
          },
          "title": "Top Shares",
          "type": "array"
        },
        "hoyer": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Hoyer",
          "type": "number"
        },
        "gini": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Gini",
          "type": "number"
        }
      },
      "required": [
        "module",
        "hoyer",
        "gini"
      ],
      "title": "TokenConcentration",
      "type": "object"
    },
    "Verdict": {
      "description": "What automated enforcement should do. Read this field.",
      "properties": {
        "action": {
          "enum": [
            "allow",
            "review",
            "block"
          ],
          "title": "Action",
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/Severity"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "title": "Reasons",
          "type": "array"
        },
        "m2_recommended": {
          "description": "Behavioural verification is recommended.",
          "title": "M2 Recommended",
          "type": "boolean"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        }
      },
      "required": [
        "action",
        "level",
        "m2_recommended",
        "confidence"
      ],
      "title": "Verdict",
      "type": "object"
    }
  },
  "description": "AdapterSentry M1 result, schema 2.0.0.",
  "properties": {
    "schema_version": {
      "default": "2.0.0",
      "pattern": "^2\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "scan": {
      "$ref": "#/$defs/ScanInfo"
    },
    "artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/Artifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Null only when the file could not be read at all."
    },
    "adapter": {
      "$ref": "#/$defs/AdapterInfo"
    },
    "status": {
      "enum": [
        "ok",
        "degraded",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    },
    "anomaly": {
      "$ref": "#/$defs/Anomaly"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "modules": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ModuleRecord"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Per-module detail; present only when requested.",
      "title": "Modules"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/ScanError"
      },
      "title": "Errors",
      "type": "array"
    }
  },
  "required": [
    "scan",
    "adapter",
    "status",
    "coverage",
    "verdict"
  ],
  "title": "ScanResult",
  "type": "object"
}
