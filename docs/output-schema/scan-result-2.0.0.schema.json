      "required": [
        "profile_id",
        "profile_version",
        "stratum",
        "n_reference",
        "distance",
        "p_value",
        "alpha_review",
        "alpha_block"
      ],
      "title": "ReferenceComparison",
      "type": "object"
    },
    "ScanError": {
      "description": "Normalized scan error — goes into AdapterReport.errors / ScanResult.errors.\n\n``code`` is a short upper-case string identifying the error.  Canonical values\nare defined in ``ErrorCode``; callers should treat ``code`` as advisory — future\nversions may emit codes not present in the current ``ErrorCode`` enum.  Always\nbranch on ``category`` for reliable machine processing; use ``code`` only for\nlogging and display.",
      "properties": {
        "category": {
          "$ref": "#/$defs/ErrorCategory"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScanPhase"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "severity": {
          "$ref": "#/$defs/ErrorSeverity",
          "default": "degraded"
        }
      },
      "required": [
        "category",
        "code",
        "message"
      ],
      "title": "ScanError",
      "type": "object"
    },
    "ScanInfo": {
      "description": "Who scanned, when, and how.",
      "properties": {
        "scan_id": {
          "description": "sha256(content_hash:config_hash:schema_version); deterministic.",
          "title": "Scan Id",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Batch run identifier, if any.",
          "title": "Run Id"
        },
        "analyzer_version": {
          "title": "Analyzer Version",
          "type": "string"
        },
        "config_hash": {
          "description": "Hash of analysis settings, including mode and policy.",
          "title": "Config Hash",
          "type": "string"
        },
        "mode": {
          "enum": [
            "fast",
            "full"
          ],
          "title": "Mode",
          "type": "string"
        },
        "policy": {
          "description": "Verdict policy; 'strict' may block on structural red flags.",
          "enum": [
            "default",
            "strict"
          ],
          "title": "Policy",
          "type": "string"
        },
        "started_at": {
          "description": "ISO 8601 UTC.",
          "title": "Started At",
          "type": "string"
        },
        "completed_at": {
          "description": "ISO 8601 UTC.",
          "title": "Completed At",
          "type": "string"
        },
        "wall_time_ms": {
          "minimum": 0,
          "title": "Wall Time Ms",
          "type": "integer"
        }
      },
      "required": [
        "scan_id",
        "analyzer_version",
        "config_hash",
        "mode",
        "policy",
        "started_at",
        "completed_at",
        "wall_time_ms"
      ],
      "title": "ScanInfo",
      "type": "object"
    },
    "ScanPhase": {
      "description": "Pipeline phase where the error occurred.",
      "enum": [
        "parse",
        "metadata",
        "feature",
        "scoring",
        "reporting",
        "behavioral"
      ],
      "title": "ScanPhase",
      "type": "string"
    },
    "Severity": {
      "description": "Ordered severity: LOW < MEDIUM < HIGH < CRITICAL.",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SiblingFile": {
      "description": "A file found next to the adapter that deserves attention.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
